{
  "name": "CrackedCode",
  "version": "2.9.5",
  "description": "Autonomous AI Coding Agent with Multi-Agent Swarm, Voice I/O, and Production-Ready App Generation",
  "model": "qwen3:8b-gpu",
  "vision_model": "llava:13b-gpu",
  "secondary_model": "dolphin-llama3:8b-gpu",
  "unified_mode": true,
  "autonomous_enabled": true,
  "autonomous_max_corrections": 3,
  "autonomous_workspace": ".autonomous",
  "streaming_enabled": true,
  "api_key": null,
  "cache_enabled": true,
  "max_context": 20,
  "max_retries": 2,
  "whisper_size": "medium",
  "tts_backend": "fallback",
  "tts_voice": "default",
  "tts_gender": "female",
  "tts_rate": 175,
  "sample_rate": 16000,
  "push_to_talk": false,
  "auto_save": true,
  "auto_save_delay_ms": 3000,
  "max_concurrent_agents": 4,
  "task_timeout": 120,
  "ollama_host": "http://localhost:11434",
  "allowed_shell_commands": [
    "git",
    "npm",
    "node",
    "python",
    "python3",
    "pip",
    "pip3",
    "ruff",
    "mypy",
    "pytest",
    "cargo",
    "go",
    "curl",
    "wget",
    "ls",
    "dir",
    "cd",
    "mkdir",
    "rm",
    "cat",
    "type",
    "find",
    "grep",
    "rg",
    "echo"
  ],
  "project_root": "C:/Users/User/Desktop/New folder",
  "logging": {
    "log_level": "INFO",
    "log_dir": "logs",
    "max_log_bytes": 5000000,
    "log_backup_count": 5,
    "use_colored_logs": true,
    "use_json_logs": false,
    "console_logging": true
  },
  "voice_enabled": true,
  "auto_load_stt": true,
  "auto_save_blackboard": true,
  "debate_rounds": 3,
  "temperature": 0.1,
  "num_ctx": 16384,
  "agents": {
    "supervisor": {
      "enabled": true,
      "system_prompt": "You are the Supervisor Agent - the orchestrator of the CrackedCode Multi-Agent Swarm."
    },
    "architect": {
      "enabled": true,
      "system_prompt": "You are the Architect Agent - system design specialist."
    },
    "coder": {
      "enabled": true,
      "system_prompt": "You are the Coder Agent - code generation specialist."
    },
    "executor": {
      "enabled": true,
      "system_prompt": "You are the Executor Agent - command execution specialist."
    },
    "reviewer": {
      "enabled": true,
      "system_prompt": "You are the Reviewer Agent - code critique specialist."
    }
  },
  "features": {
    "voice_io": true,
    "multi_agent_swarm": true,
    "debate_protocol": true,
    "blackboard_memory": true,
    "tool_use": true,
    "json_output": true,
    "parallel_execution": true,
    "plan_build_mode": true,
    "autonomous_production": true,
    "heartbeat_scheduler": true,
    "skill_system": true,
    "persistent_workspace": true
  },
  "models": {
    "recommended": [
      "qwen3:8b-gpu",
      "llava:13b-gpu",
      "dolphin-llama3:8b-gpu"
    ],
    "stt": [
      "tiny",
      "base",
      "small",
      "medium"
    ],
    "tts": [
      "en_US-lessac-medium"
    ]
  },
  "security": {
    "allow_arbitrary_code": false,
    "sandbox_commands": true,
    "command_whitelist_only": true
  },
  "performance": {
    "max_workers": 4,
    "task_timeout": 120,
    "gpu_acceleration": true
  },
  "notifications": {
    "enabled": true,
    "min_level": "info",
    "email": {
      "enabled": false,
      "smtp_host": "smtp.gmail.com",
      "smtp_port": 587,
      "username": null,
      "password": null,
      "from": "crackedcode@localhost",
      "to": [],
      "use_tls": true
    },
    "webhook": {
      "enabled": false,
      "url": null,
      "headers": {
        "Content-Type": "application/json"
      },
      "timeout": 10
    },
    "desktop": {
      "enabled": false
    }
  },
  "metrics": {
    "enabled": true,
    "max_history": 10000,
    "persist": true
  },
  "docker": {
    "enabled": false,
    "ollama_host_env": "OLLAMA_HOST",
    "default_ollama_host": "http://ollama:11434",
    "health_check_interval": 30
  },
  "github": {
    "enabled": false,
    "token": null,
    "auto_review_prs": false,
    "review_comment_template": "\u00f0\u0178\u00a4\u2013 CrackedCode AI Review\n\n**Verdict:** {verdict}\n\n{summary}\n\n---\n*Reviewed by CrackedCode*"
  },
  "rate_limiting": {
    "enabled": true,
    "max_requests": 60,
    "window_seconds": 60
  },
  "web_dashboard": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 3000
  },
  "custom_tools": {
    "enabled": true,
    "tools_dir": "tools",
    "auto_reload": true,
    "max_tools": 50
  },
  "workflows": {
    "enabled": true,
    "workflows_dir": "workflows",
    "auto_reload": true,
    "max_workflows": 20
  },
  "agent_collaboration": {
    "enabled": true,
    "default_agents": [
      "architect",
      "security",
      "coder"
    ],
    "max_rounds": 5,
    "require_consensus": false
  },
  "code_review_bot": {
    "enabled": true,
    "auto_review": false,
    "monitor_interval": 300,
    "min_severity": "medium"
  },
  "knowledge_base": {
    "enabled": true,
    "storage_dir": ".crackedcode/knowledge",
    "supported_types": [
      "pdf",
      "markdown",
      "text",
      "html",
      "docx"
    ],
    "chunk_size": 500,
    "chunk_overlap": 50
  },
  "model_finetune": {
    "enabled": true,
    "data_dir": ".crackedcode/finetune",
    "default_base_model": "qwen3:8b",
    "min_quality_score": 0.7
  },
  "sdk": {
    "enabled": true,
    "default_base_url": "http://localhost:8080",
    "timeout": 120,
    "max_retries": 3
  },
  "benchmarks": {
    "enabled": true,
    "storage_dir": ".crackedcode/benchmarks",
    "default_suite": "all",
    "auto_run_on_startup": false
  },
  "self_healing": {
    "enabled": true,
    "auto_fix": false,
    "watch_interval": 5,
    "max_fixes_per_session": 10,
    "require_tests_pass": true
  },
  "agent_memory": {
    "enabled": true,
    "storage_dir": ".crackedcode/agent_memory",
    "max_entries_per_agent": 1000,
    "auto_summarize_threshold": 50,
    "categories": [
      "fact",
      "preference",
      "decision",
      "error",
      "fix",
      "interaction"
    ],
    "inject_into_prompts": true,
    "max_context_entries": 3
  },
  "git_hooks": {
    "enabled": true,
    "block_on_critical": true,
    "warn_on_high": true,
    "timeout_seconds": 60
  },
  "memory_viz": {
    "enabled": true,
    "default_limit": 10,
    "show_colors": true,
    "max_width": 70
  },
  "execution_tracer": {
    "enabled": true,
    "storage_dir": ".crackedcode/traces",
    "max_age_hours": 24,
    "auto_trace": true,
    "trace_components": [
      "engine",
      "agent",
      "tool",
      "memory"
    ]
  },
  "doctor": {
    "enabled": true,
    "check_interval_seconds": 300,
    "auto_alert": false,
    "components": [
      "ollama",
      "engine",
      "api",
      "memory",
      "git",
      "voice",
      "files"
    ]
  },
  "stt_language": "en",
  "stt_beam_size": 5,
  "tts_volume": 1.0,
  "hotword": "verily ",
  "font_size": 11,
  "line_numbers": false
}