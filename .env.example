# CrackedCode Environment Configuration
# Copy to .env and customize

# Ollama connection
OLLAMA_HOST=http://ollama:11434

# API Authentication (optional)
# CRACKEDCODE_API_KEY=your-secret-key

# Models
CRACKEDCODE_MODEL=qwen3:8b
CRACKEDCODE_VISION_MODEL=llava:13b
CRACKEDCODE_SECONDARY_MODEL=dolphin-llama3:8b

# Features
CRACKEDCODE_STREAMING_ENABLED=true
CRACKEDCODE_VOICE_ENABLED=false

# Notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL_TO=your-email@gmail.com

# Webhook
# WEBHOOK_URL=https://hooks.slack.com/services/...
